rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Only the fields the Negotiation Planner writes.
    function validPlan() {
      return request.resource.data.keys().hasOnly(
        ['v', 'meta', 'fields', 'rows', 'owners', 'zopa', 'presence', 'updatedAt']);
    }

    match /plans/{planId} {
      // Anyone signed in (the app signs everyone in anonymously) can open a plan
      // if they know its link. Listing all plans is not allowed.
      allow get: if request.auth != null;
      allow create: if request.auth != null
                    && planId.matches('^[A-Za-z0-9]{20,40}$')
                    && validPlan();
      allow update: if request.auth != null && validPlan();
      allow list, delete: if false;
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
